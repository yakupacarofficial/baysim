# Godot 4+ specific ignores
.godot/
.godot-user/
/android/

# User-specific launcher and runtime state
/launcher/settings.json
/runtime/*.json
/runtime/*.json.tmp
/runtime/*.log

# Python bytecode
__pycache__/
*.py[cod]

# World builder ara/geçici çıktıları. Ham GeoTIFF kaynakları Git LFS ile
# sürümlenir (bkz. .gitattributes); yalnızca scratch dizini yok sayılır.
/data/scratch/
